# Copy to `.env` and fill in as needed. Do NOT commit real secrets.
# These are read by config.py at startup (secrets are never written back to disk).

# --- OpenAI GPT vision detector ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.5

# --- Synoptic / MesoWest weather (free token: https://synopticdata.com) ---
SYNOPTIC_TOKEN=

# --- Field site defaults (used for weather/tide fetches) ---
TIDEGATE_LAT=43.45
TIDEGATE_LON=-124.20
TIDEGATE_TZ=America/Los_Angeles
TIDEGATE_SITE=Willanch Slough Tide Gate (Coos Bay, OR)
